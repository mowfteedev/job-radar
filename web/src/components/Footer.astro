---
interface Props {
  lastUpdated?: string;
}

const { lastUpdated = new Date().toISOString() } = Astro.props;
const formattedDate = new Date(lastUpdated).toLocaleString('vi-VN', {
  timeZone: 'Asia/Ho_Chi_Minh',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
  hour: '2-digit',
  minute: '2-digit'
});
---

<footer class="mt-auto border-t border-slate-800/80 bg-slate-950/60 py-8 px-4 sm:px-6 lg:px-8">
  <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
    <div class="flex flex-col sm:flex-row items-center gap-2 sm:gap-4 text-center sm:text-left">
      <span class="font-mono text-slate-300">
        📡 <strong class="text-white">VN Tech Job Radar</strong> • Serverless 0 Đồng
      </span>
      <span class="hidden sm:inline text-slate-600">|</span>
      <span class="font-mono">
        Cập nhật: <span class="text-emerald-400">{formattedDate} (UTC+7)</span>
      </span>
    </div>

    <div class="flex items-center gap-4 font-mono">
      <a
        href="https://github.com/mowfteedev/job-radar"
        target="_blank"
        rel="noopener noreferrer"
        class="hover:text-emerald-400 transition-colors"
      >
        Mã Nguồn GitHub
      </a>
      <span class="text-slate-700">•</span>
      <span class="text-slate-500">Được vận hành bởi mowftee-guild</span>
    </div>
  </div>
</footer>
